EMAIL_FROM=noreply@starsmiles.com.au
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://starsmiles.com.au
NEXT_PUBLIC_PHONE_NUMBER=+61398030933
NEXT_PUBLIC_EMAIL=info@starsmiles.com.au

# Analytics (Optional)
